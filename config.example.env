# Example values only. The server reads environment variables, not this file.
PUBLIC_ORIGIN=https://phones.example.internal
AD_URL=ldaps://dc01.example.internal:636
AD_ALLOWED_OUS=OU=Employees,DC=example,DC=internal
AD_PHONE_ATTRIBUTE=telephoneNumber
AD_BIND_DN=CN=Phone Service,OU=Services,DC=example,DC=internal
# Inject AD_BIND_PASSWORD through the host's secret manager; never commit it.
# Format policy is a Go RE2 expression, automatically anchored.
PHONE_PATTERN=[+0-9(). -]{3,32}
